-keep class org.apache.commons.httpclient.auth.AuthPolicy
-keep class org.apache.commons.httpclient.cookie.CookiePolicy
-keep class * implements org.apache.commons.httpclient.auth.AuthScheme {
    public <init>();
}
-keep class * implements org.apache.commons.httpclient.cookie.CookieSpec {
    public <init>();
}

-keeppackagenames org.apache.jackrabbit.webdav
