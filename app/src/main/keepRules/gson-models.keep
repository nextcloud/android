-keepclassmembers class com.owncloud.android.authentication.AuthObject,
        com.owncloud.android.authentication.Poll,
        com.owncloud.android.authentication.LoginUrlInfo,
        com.owncloud.android.authentication.EnforcedServer,
        com.owncloud.android.datamodel.PushConfigurationState,
        com.owncloud.android.datamodel.MediaFoldersModel,
        com.owncloud.android.datamodel.DecryptedPushMessage,
        com.nextcloud.client.jobs.LogEntry,
        com.nextcloud.appReview.AppReviewShownModel,
        com.nextcloud.client.NominatimClient$Companion$ReverseGeocodingResult,
        com.nextcloud.model.OfflineOperationType$* {
    !static !transient <fields>;
    <init>(...);
}

-keepclassmembers class com.owncloud.android.datamodel.e2e.**,
        com.owncloud.android.datamodel.EncryptedFiledrop {
    <fields>;
    <init>(...);
}
