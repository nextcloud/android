# ez-vcard's CaseClasses look up the predefined parameter values (TelephoneType.CELL, ImageType.JPEG, ...) with
# Class.getFields() and create unknown values through these constructors with getDeclaredConstructor().
# SupportedVersionsHelper reads the @SupportedVersions annotation from the same public static fields.
-keepclassmembers class * extends ezvcard.parameter.VCardParameter {
    public static <fields>;
    <init>(java.lang.String);
    <init>(java.lang.String, ezvcard.VCardVersion[]);
    <init>(java.lang.String, java.lang.String, java.lang.String);
}
