# Single Sign-On client apps send these classes through Java serialization, so class names, field names and
# serialVersionUID must match the Android-SingleSignOn library. They are never constructed in this app, so without
# this rule R8 treats them as uninstantiated and removes them. PlainHeader is also returned to clients as Gson JSON.
-keep class com.nextcloud.android.sso.aidl.NextcloudRequest,
            com.nextcloud.android.sso.QueryParam,
            com.nextcloud.android.sso.PlainHeader {
    static final long serialVersionUID;
    !static !transient <fields>;
    <init>(...);
    private void writeObject(java.io.ObjectOutputStream);
    private void readObject(java.io.ObjectInputStream);
}
