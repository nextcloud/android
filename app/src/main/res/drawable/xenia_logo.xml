    android:height="68dp"
    android:viewportWidth="900"
    android:viewportHeight="635">
    <group
        android:scaleX="2.984500"
        android:scaleY="2.984500"
        android:translateX="-251.7306"
        android:translateY="-343.1710">
        <group
            android:scaleX="1.041667"
            android:scaleY="1.041667"
            android:translateX="-35.70501"
            android:translateY="13.034049">
            <path
                android:fillColor="#ffffff"
                android:fillType="nonZero"
                android:pathData="m 188,296 c -36,0 -64,-28 -64,-62 0,-34 26,-61 60,-62 6,-40 38,-68 76,-68 38,0 70,28 76,68 34,1 60,28 60,62 0,34 -28,62 -64,62 z" />
        </group>
    </group>
</vector>
