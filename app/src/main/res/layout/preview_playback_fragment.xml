<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/player_background_color">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/player_file_icon_size"
        android:layout_height="@dimen/player_file_icon_size"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/video_white" />

    <ImageView
        android:id="@+id/thumbnail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <SurfaceView
        android:id="@+id/surfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="gone" />

    <com.nextcloud.client.player.ui.control.PlayerControlView
        android:id="@+id/playerControlView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/player_video_control_view_background_color" />

</FrameLayout>
